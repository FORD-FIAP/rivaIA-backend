<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Caminho dos arquivos de log (sobrescrevivel via variavel de ambiente). -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- Console legivel, com os campos do MDC visiveis (dev/test, sem obs). -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} [trace=%X{trace_id:-} ip=%X{client_ip:-} user=%X{user_id:-}] - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- JSON para o stdout (ingestao por ELK/Datadog/CloudWatch no ambiente real). -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>
            <includeMdcKeyName>client_ip</includeMdcKeyName>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <logger>logger_name</logger>
                <message>message</message>
                <thread>thread_name</thread>
            </fieldNames>
            <customFields>{"application":"riva-backend"}</customFields>
        </encoder>
    </appender>

    <!-- JSON em arquivo rotacionado - consumido pelo Promtail -> Loki -> Grafana. -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/riva-backend.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/riva-backend-%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>
            <includeMdcKeyName>client_ip</includeMdcKeyName>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <logger>logger_name</logger>
                <message>message</message>
                <thread>thread_name</thread>
            </fieldNames>
            <customFields>{"application":"riva-backend"}</customFields>
        </encoder>
    </appender>

    <!--
        As tres condicoes abaixo sao mutuamente exclusivas (dev/test sem obs vs.
        dev/test com obs vs. prod) para evitar que mais de um <root> seja ativado
        ao mesmo tempo — o que faria o Logback acumular appenders e duplicar/
        triplicar cada linha de log (bug corrigido nesta revisao).
    -->

    <!-- Dev/test sem observabilidade: so console legivel. -->
    <springProfile name="(dev | test) &amp; !obs">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Dev com observabilidade: console legivel + arquivo JSON para o Promtail. -->
    <springProfile name="(dev | test) &amp; obs">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

    <!-- Producao: saida JSON estruturada no stdout e em arquivo. -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

</configuration>
